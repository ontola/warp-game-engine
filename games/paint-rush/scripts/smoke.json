{ "size": [1280, 720],
  "steps": [
    { "ticks": 2 },
    { "expect": "/errors", "equals": [] },
    { "expect": "/state/round", "equals": 1 },
    { "expect": "/state/s/players/0/score", "equals": 1, "note": "player 1 owns the tile it starts on" },
    { "ticks": 60, "mv": [1, 0], "note": "roll right for a second: 260 units, eight or nine tiles" },
    { "expect": "/state/s/players/0/x", "min": 455, "max": 465 },
    { "expect": "/state/s/players/0/score", "min": 9 },
    { "ticks": 2, "hold": ["SOUTH"], "note": "burst: a diamond of 13 tiles" },
    { "expect": "/state/s/players/0/cool", "min": 3.9 },
    { "expect": "/state/s/players/0/score", "min": 18 },
    { "ticks": 600, "mv": [0.3, -0.8], "hold": ["SOUTH"], "note": "paint towards the camera, bursting when ready" },
    { "capture": "paint.png", "state": "paint.json" },
    { "expect": "/errors", "equals": [] },
    { "until": "/state/s/results", "min": 0.1, "max_ticks": 4000, "mv": [-0.6, 0.6], "hold": ["SOUTH"], "note": "the round runs out" },
    { "capture": "paint-results.png" },
    { "audio": "paint.wav" }
  ] }
