-- Generated by scripts/sync_growing_guns.py from Growing Guns' base gun and cards.
local max, deg_to_rad, Color = math.max, math.rad, vector.create
local function lerp(a,b,t) return a+(b-a)*t end
local gun = {
    damage = 22.0,
    fire_interval = 0.22,
    mag_size = 5,
    reload_time = 1.2,
    spread = 0.008,
    headshot = 2.0,
}
local cards = {
    shotgun = function(w)
			w.extra_projectiles += 2
			w.reload_mult *= 1.5
			w.damage_mult *= 1.5
			w.fire_rate_mult *= 0.3
			w.bullet_speed_mult *= 0.75
			w.spread = max(w.spread, deg_to_rad(2.0)) + deg_to_rad(2.0)
    end,
    uzi = function(w)
			w.fire_rate_mult *= 3.0
			w.mag_size_bonus += 20
			w.damage_mult *= 0.7
			w.spread *= 2
			w.bullet_color = lerp(w.bullet_color, Color(1.0, 0.55, 0.15), 0.5)
    end,
    sniper = function(w)
			w.damage_mult *= 3.0
			w.bullet_speed_mult *= 2.5
			w.fire_rate_mult *= 0.4
			w.spread *= 0.1
			w.headshot_mult *= 1.5
			w.special = "zoom"
			w.bullet_color = lerp(w.bullet_color, Color(0.55, 0.85, 1.0), 0.6)
    end,
}
return {gun=gun, cards=cards}
