{ "size": [1280, 720],
  "steps": [
    { "ticks": 2 },
    { "expect": "/errors", "equals": [] },
    { "expect": "/state/round", "equals": 1 },
    { "ticks": 2, "mv": [-1, 0], "hold": ["SOUTH"], "note": "player 1 dashes towards the centre" },
    { "expect": "/state/s/players/0/cool", "min": 1.0 },
    { "expect": "/state/s/players/0/vx", "max": -300 },
    { "ticks": 240, "note": "the bots go for each other" },
    { "capture": "bumper.png", "state": "bumper.json" },
    { "until": "/state/s/players/0/flash", "max": 0, "max_ticks": 120 },
    { "until": "/state/s/players/0/flash", "min": 0.01, "max_ticks": 600, "mv": [0, -1], "note": "ride off the near edge: back in the middle as a ghost" },
    { "ticks": 12 },
    { "capture": "bumper-fall.png" },
    { "expect": "/errors", "equals": [] },
    { "until": "/state/s/results", "min": 0.1, "max_ticks": 4000, "note": "the round runs out" },
    { "expect": "/state/s/radius", "equals": 200 },
    { "capture": "bumper-results.png" },
    { "audio": "bumper.wav" }
  ] }
