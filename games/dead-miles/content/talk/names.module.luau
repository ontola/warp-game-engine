-- Talk on the way, when it is quiet: who says what, in turn. {a} and {b}
-- are the two talking; {a_who}/{a_lost} whom a lost and their name,
-- {a_from} where a is from; {days} days since it got out.
return {
	id = "names",
	lines = {
		{ "a", "Do you still say their names? At night?" },
		{ "b", "{b_lost}. Every night. In case." },
		{ "a", "{a_lost}. Same." },
	},
}
