{ "size": [1280, 720],
  "steps": [
    { "ticks": 2 },
    { "expect": "/errors", "equals": [] },
    { "expect": "/state/s/hp", "equals": 5, "note": "the egg starts with five lives" },
    { "ticks": 60, "mv": [1, 0], "note": "stick right: guard 1 turns clockwise" },
    { "expect": "/state/s/guards/0/angle", "min": 1.8, "max": 2.0 },
    { "press": ["EAST"], "ticks": 2, "note": "B: the wide guard" },
    { "expect": "/state/s/guards/0/wide", "min": 0.9 },
    { "ticks": 600, "hold": ["SOUTH"], "mv": [-0.6, 0], "note": "boosting the other way" },
    { "expect": "/state/s/kills", "min": 1, "note": "the guards have caught swimmers" },
    { "capture": "anticonception.png", "state": "anticonception.json" },
    { "until": "/state/s/over", "equals": true, "max_ticks": 5000, "note": "the round ends: 90 s or the egg falls" },
    { "capture": "anticonception-end.png" },
    { "audio": "anticonception.wav" }
  ] }
