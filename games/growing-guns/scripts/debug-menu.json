{ "size": [1280, 720],
  "steps": [
    { "note": "The F3 debug overlay (hud/debug.rs). F3 itself is a window key; scripts open it with `debug on` or a pad's Back + Start, then drive it as a player would. The match keeps running under it." },
    { "cmd": ["bots pause", "cage"], "ticks": 30 },
    { "hold": ["SELECT"], "press": ["START"], "ticks": 2, "note": "Back + Start opens it" },
    { "expect": "/debug/open", "equals": true },
    { "expect": "/screen", "equals": "Play", "note": "no pause menu behind it" },
    { "capture": "debug-cards.png" },
    { "cmd": ["debug focus search"], "ticks": 2 },
    { "expect": "/menu/text_input", "equals": true },
    { "text": "rapid" }, { "ticks": 2 },
    { "expect": "/debug/search", "equals": "rapid" },
    { "capture": "debug-search.png" },
    { "keys": ["Enter"], "ticks": 2, "note": "Enter gives the first match to the target" },
    { "expect": "/players/0/cards/0", "equals": "rapid_fire" },
    { "keys": ["Escape"], "ticks": 2, "note": "Esc in the field clears the search" },
    { "expect": "/debug/search", "equals": "" },
    { "note": "Target player 2, then the first card line with the pad: down, A." },
    { "cmd": ["debug focus 1"] }, { "press": ["RIGHT"], "ticks": 2 },
    { "expect": "/debug/player", "equals": 1 },
    { "press": ["DOWN"], "ticks": 2 }, { "press": ["DOWN"], "ticks": 2 },
    { "press": ["SOUTH"], "ticks": 2 },
    { "expect": "/players/1/cards/0" },
    { "note": "RB: the ITEMS tab; a pickup drops on the target." },
    { "cmd": ["debug player 0"], "press": ["RIGHT_SHOULDER"], "ticks": 2 },
    { "expect": "/debug/tab", "equals": "ITEMS" },
    { "cmd": ["debug focus 5"], "press": ["SOUTH"], "ticks": 2 },
    { "expect": "/pickups", "min": 1 },
    { "capture": "debug-items.png" },
    { "note": "SKY: night, clear." },
    { "cmd": ["debug tab sky", "debug focus 8"], "press": ["SOUTH"], "ticks": 20 },
    { "expect": "/sky/choice", "equals": "night:clear" },
    { "capture": "debug-sky-night.png" },
    { "note": "MODES: Blackout (the 12th modifier: line 7, right) starts a round with it now." },
    { "cmd": ["debug tab modes", "debug focus 7"], "press": ["RIGHT"], "ticks": 2 },
    { "expect": "/debug/focused", "equals": "BLACKOUT" },
    { "press": ["SOUTH"], "ticks": 30 },
    { "expect": "/modifier", "equals": "blackout" },
    { "capture": "debug-blackout.png" },
    { "cmd": ["debug focus 9"], "press": ["SOUTH"], "ticks": 30, "note": "LAVA LEAK" },
    { "expect": "/arena/leak_surface" },
    { "capture": "debug-lava.png" },
    { "press": ["EAST"], "ticks": 2, "note": "B closes it" },
    { "expect": "/debug/open", "equals": false },
    { "capture": "debug-closed.png" }
  ] }
