{ "size": [960, 540],
  "steps": [
    { "note": "UI parity tour: the in-game HUD, hit feedback, the card pick, the pause and settings menus, the Tab scoreboard. Compare with the Godot screens (docs/ui-parity.md)." },
    { "cmd": ["bots pause", "health 0 5000"] },
    { "ticks": 30 },
    { "capture": "hud.png" },
    { "ticks": 6, "hold": ["RIGHT_TRIGGER"] },
    { "capture": "firing.png" },
    { "ticks": 1, "hold": ["SELECT"] },
    { "capture": "scoreboard.png" },
    { "press": ["START"] },
    { "ticks": 2 },
    { "capture": "pause.png" },
    { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["SOUTH"] }, { "ticks": 2 },
    { "capture": "settings.png" },
    { "expect": "/screen", "equals": "Settings { from_start: false }" },
    { "ticks": 20, "hold": ["RIGHT"] },
    { "capture": "settings-moved.png" },
    { "press": ["EAST"] }, { "ticks": 1 },
    { "press": ["START"] }, { "ticks": 2 },
    { "capture": "resumed.png" },
    { "cmd": ["bots resume", "health 0 1"] },
    { "until": "/players/0/offer", "max_ticks": 6000 },
    { "ticks": 20 },
    { "capture": "offer-flip.png" },
    { "ticks": 60 },
    { "capture": "offer.png" },
    { "press": ["RIGHT"] }, { "ticks": 12 },
    { "capture": "offer-focus.png" },
    { "press": ["SOUTH"] }, { "ticks": 8 },
    { "capture": "picked.png" },
    { "expect": "/players/0/cards/0" }
  ] }
