{ "size": [960, 540],
  "steps": [
    { "note": "Splitscreen hot-join (run with --players 1): two virtual pads beside the keyboard. The hint, SPLITSCREEN in the pause menu, PRESS X TO JOIN, a pad joining over a bot, its PLAYER MENU and LEAVE." },
    { "pads": 2, "cmd": ["bots pause"], "ticks": 20 },
    { "expect": "/local/hint", "equals": true },
    { "capture": "hint.png" },
    { "press": ["START"] }, { "ticks": 2 },
    { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "press": ["DOWN"] }, { "ticks": 2 },
    { "capture": "pause-splitscreen.png" },
    { "press": ["SOUTH"] }, { "ticks": 2 },
    { "expect": "/local/split", "equals": true },
    { "expect": "/screen", "equals": "Play" },
    { "ticks": 20 },
    { "expect": "/local/join_prompt", "equals": true },
    { "capture": "join-prompt.png" },
    { "note": "pad1 presses X: it takes player 2's seat (a bot until now)." },
    { "device": "pad1", "press": ["X"] },
    { "expect": "/local/seats", "equals": [0, 1] },
    { "expect": "/players/1/bot", "equals": false },
    { "ticks": 10 },
    { "capture": "joined.png" },
    { "device": "pad1", "mv": [0, 1], "ticks": 60 },
    { "device": "pad0", "press": ["X"] }, { "ticks": 30 },
    { "expect": "/local/seats", "equals": [0, 1, 2] },
    { "capture": "joined-three.png" },
    { "device": "pad1", "press": ["START"] }, { "ticks": 2 },
    { "expect": "/local/player_menu", "equals": 1 },
    { "device": "pad1", "press": ["DOWN"] }, { "ticks": 2 },
    { "capture": "player-menu.png" },
    { "device": "pad1", "press": ["A"] }, { "ticks": 20 },
    { "expect": "/local/seats", "equals": [0, 2] },
    { "expect": "/players/1/bot", "equals": true },
    { "capture": "left.png" },
    { "cmd": ["split off"] }, { "ticks": 20 },
    { "expect": "/local/seats", "equals": [0] },
    { "capture": "split-off.png" }
  ] }
