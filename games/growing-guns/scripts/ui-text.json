{ "size": [960, 540],
  "steps": [
    { "note": "Text entry: the pause menu's join field, the start screen's, the Player name in settings and a pad's on-screen keyboard. The clipboard is the script's own (app::script never touches the system's)." },
    { "cmd": ["bots pause", "menu pause", "focus join"] }, { "ticks": 2 },
    { "expect": "/menu/text_input", "equals": true },
    { "text": "not-a-match-id" }, { "ticks": 2 },
    { "expect": "/menu/join_field", "equals": "not-a-match-id" },
    { "capture": "join-invalid.png" },
    { "keys": ["Home", "Delete", "Delete", "Delete", "Delete", "End", "Backspace", "Backspace", "Backspace"] }, { "ticks": 2 },
    { "expect": "/menu/join_field", "equals": "a-match" },
    { "keys": ["Home", "Delete", "Delete", "Delete", "Delete", "Delete", "Delete", "Delete"] }, { "ticks": 2 },
    { "expect": "/menu/join_field", "equals": "" },
    { "capture": "join-empty.png" },
    { "note": "A long ID scrolls inside the field, caret at the end." },
    { "text": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" }, { "ticks": 2 },
    { "capture": "join-long.png" },
    { "keys": ["Escape"] }, { "ticks": 2 },
    { "expect": "/screen", "equals": "Play" },
    { "cmd": ["menu settings"] }, { "ticks": 2 },
    { "expect": "/menu/text_input", "equals": true },
    { "text": "Joep" }, { "keys": ["Enter"] }, { "ticks": 2 },
    { "expect": "/menu/player_name", "equals": "Joep" },
    { "capture": "settings-name.png" },
    { "note": "A pad on the name field: A opens the on-screen keyboard, A types, X deletes, START is done." },
    { "press": ["SOUTH"] }, { "ticks": 2 },
    { "expect": "/menu/picker", "equals": true },
    { "press": ["RIGHT"] }, { "ticks": 2 }, { "press": ["SOUTH"] }, { "ticks": 2 },
    { "press": ["DOWN"] }, { "ticks": 2 }, { "press": ["SOUTH"] }, { "ticks": 2 },
    { "capture": "settings-picker.png" },
    { "press": ["WEST"] }, { "ticks": 2 },
    { "press": ["START"] }, { "ticks": 2 },
    { "expect": "/menu/picker", "equals": false },
    { "expect": "/menu/player_name", "equals": "Joepb" },
    { "press": ["DOWN"] }, { "ticks": 2 },
    { "expect": "/menu/text_input", "equals": false },
    { "cmd": ["menu none", "names"] }, { "ticks": 10 },
    { "hold": ["SELECT"], "ticks": 2 },
    { "capture": "name-scoreboard.png" },
    { "note": "The start screen's join field, pasted into (the start screen makes the local seat a bot, so it comes last)." },
    { "cmd": ["menu start", "focus join"] }, { "ticks": 2 },
    { "clipboard": "Join my Growing Guns match!\n(not a real id)" },
    { "keys": ["Paste"] }, { "ticks": 2 },
    { "capture": "start-join-pasted.png" }
  ] }
