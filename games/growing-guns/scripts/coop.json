{ "size": [640, 360],
  "note": "run with --coop --players 2: the first enemies rise, a human goes down and is revived, then the run is lost",
  "steps": [
    { "cmd": ["bots pause"] },
    { "expect": "/waves/wave", "equals": 1 },
    { "expect": "/waves/total", "equals": 4 },
    { "until": "/waves/incoming/left", "min": 0.0, "max_ticks": 120 },
    { "capture": "telegraph.png", "state": "telegraph.json" },
    { "ticks": 60 }, { "capture": "rising.png" },
    { "ticks": 120 },
    { "expect": "/players/4/alive", "equals": true },
    { "cmd": ["health 0 1", "teleport 0 0 40 0", "boom 0 40 0 3 50"], "ticks": 2 },
    { "expect": "/players/0/downed", "equals": true },
    { "ticks": 120 }, { "capture": "down.png" },
    { "cmd": ["teleport 1 0.5 40 0"], "ticks": 1 },
    { "until": "/players/0/downed", "equals": false, "max_ticks": 600 },
    { "expect": "/players/0/health", "equals": 300 },
    { "ticks": 90 }, { "capture": "revived.png", "state": "revived.json" },
    { "cmd": ["teleport 1 0 -40 0"], "ticks": 2, "note": "fell off the map: down, a teammate stands" },
    { "expect": "/players/1/downed", "equals": true },
    { "cmd": ["teleport 0 0 -40 0"], "ticks": 2, "note": "nobody left standing" },
    { "expect": "/phase", "equals": "MatchOver" },
    { "ticks": 30 }, { "capture": "failed.png", "state": "failed.json" }
  ] }
