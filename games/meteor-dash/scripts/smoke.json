{ "size": [1280, 720],
  "steps": [
    { "ticks": 2 },
    { "expect": "/errors", "equals": [] },
    { "expect": "/state/s/ships/0/y", "equals": 590, "note": "ship 1 starts near the bottom" },
    { "ticks": 30, "mv": [0, 1], "note": "stick up: fly away from the camera" },
    { "expect": "/state/s/ships/0/y", "max": 500 },
    { "press": ["SOUTH"], "ticks": 2, "note": "A: shield dash" },
    { "expect": "/state/s/ships/0/shield", "min": 0.2 },
    { "capture": "meteor-dash.png" },
    { "ticks": 300, "mv": [0.5, -0.2] },
    { "capture": "meteor.png", "state": "meteor.json" },
    { "ticks": 3300 },
    { "expect": "/state/s/over", "equals": true, "note": "the round ends after 60 s" },
    { "capture": "meteor-end.png" },
    { "audio": "meteor.wav" }
  ] }
