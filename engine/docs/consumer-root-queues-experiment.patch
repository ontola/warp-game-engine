+// Shadow-only roots stay outside the camera frontier. Their baseline work was
+// already reserved by seed; do not reserve it twice or clear camera outputs.
+@compute @workgroup_size(64) fn seed_shadow(@builtin(global_invocation_id) id:vec3<u32>) {
+ let tree=id.x;if tree>=view.counts.x {return;}
+ let consumers=demand[tree].bucket;let shadow=consumers==512u;
+ current[tree]=vec4<u32>(tree,NONE,select(0u,consumers,shadow),0u);
+ var p:Proposal;p.control=vec4<u32>(0u,0u,select(0u,1u,shadow),select(0u,1u,shadow));proposals[tree]=p;
+}
+@compute @workgroup_size(1) fn start_shadow() {atomicStore(&state[3],view.counts.x);}
+@compute @workgroup_size(64) fn compact_seed(@builtin(global_invocation_id) id:vec3<u32>) {
+ let at=id.x;if at>=atomicLoad(&state[3]) {return;}
+ if proposals[at].control.w!=0u && (atomicLoad(&state[15])&2u)==0u {
+  next[proposals[at].output.x+blocks[32u+(at/256u)*32u].y]=current[at];
+ }
+}
 @compute @workgroup_size(1) fn prepare() {
  let count=atomicLoad(&state[3]);
  for(var k=0u;k<3u;k++) {atomicStore(&state[4u+k],atomicLoad(&state[k]));}
