+// A spatial split can restart each child at a coarser local pyramid level.
+// Look through those levels as a complete preorder frontier. Never publish an
+// intermediate quality regression merely to reach useful descendants later.
+fn replacement_candidate(tree:u32,start:u32,parent:u32,request_pages:bool,roles:u32)->u32 {
+ var selected=candidate(tree,start,request_pages,roles);
+ if parent==NONE {return selected;}
+ let p=nodes[parent];if (p.links.w&1u)!=0u {return selected;}
+ loop {
+  let c=nodes[selected];if c.links.x==NONE {break;}
+  let worse=c.error.x>p.error.x || (p.error.y>0.0 && c.error.y>p.error.y);
+  if !worse {break;}
+  selected=candidate(tree,c.links.x,request_pages,roles);
+ }
+ return selected;
+}
